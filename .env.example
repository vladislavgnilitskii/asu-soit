# База данных
# Приложение подключается непривилегированной ролью app_backend (миграция 015):
# сама почти без прав, но на каждый запрос перевоплощается в роль сотрудника
# (SET ROLE) — тогда действуют GRANT (модуль 1) и RLS (модуль 2).
# Миграции и админ-операции выполняются суперпользователем (postgres) отдельно.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asu_soit
DB_USER=app_backend
DB_PASSWORD=app_backend_pw

# Приложение
APP_PORT=8080
APP_ENV=development

# JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=24h

# Ключ шифрования паспортных данных (pgcrypto, миграция 016).
# Хранится ТОЛЬКО здесь/в секрете приложения, НЕ в базе: дамп БД без ключа
# бесполезен. Приложение передаёт его в pgp_sym_encrypt/decrypt при записи/чтении
# паспорта (используется, когда появится CRUD паспортных данных).
CRYPTO_KEY=changeme
